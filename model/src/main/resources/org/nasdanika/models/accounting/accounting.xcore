@Ecore(nsURI="https://accounting.models.nasdanika.org", nsPrefix="org.nasdanika.models.accounting")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.accounting

import java.math.BigDecimal
import java.util.Date

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

//import org.nasdanika.models.accounting.AccountingPackage
//import org.eclipse.emf.ecore.EObject

// TODO - move the model to resources
// TODO - Work specialization with accounts. E.g. "Paint the house" is work, it may have materials and labor accounts.

// TODO - roles on the account, 

@GenModel(documentation="Base class for named model elements.")
abstract class NamedElement {
    String name
    @GenModel(documentation="Markdown documentation of this element.")
    String description
}

@GenModel(documentation="The root container, one per household or per concern. Contains accounts, commodities, and import sources.")
class Ledger extends NamedElement {
    contains Account[] accounts
    contains Commodity[] commodities
    contains Source[] sources
}

@GenModel(documentation="Anything countable: currencies, securities, points, miles.")
class Commodity extends NamedElement {
    @GenModel(documentation="Commodity code, e.g. ISO 4217 currency code or ticker symbol.")
    String code
    @GenModel(documentation="Number of decimal digits in the minor unit, e.g. 2 for USD.")
    int fractionDigits
}

@GenModel(documentation="A node in the account hierarchy. Unlike single-commodity designs, an account may hold balances in multiple commodities. Entries are contained by the account they describe.")
class Account extends NamedElement {
    contains Account[] children
    contains Entry[] entries
    @GenModel(documentation="Commodities this account may hold. Empty means unrestricted.")
    refers Commodity[] commodities
}

@GenModel(documentation="Lifecycle state of an entry, making 'checked for legitimacy but not yet categorized' a representable, queryable condition.")
enum EntryState {
    imported
    reviewed
    reconciled
}

@GenModel(documentation="Where entries came from: a statement file, an institution download, manual entry. Enables staged reconciliation and audit.")
class Source extends NamedElement {
    @GenModel(documentation="Location of the source artifact, e.g. a QFX/OFX/CSV file URI or an institution endpoint.")
    String location
    @GenModel(documentation="Format of the source artifact, e.g. QFX, OFX, CSV, manual.")
    String format
    Date importedAt
}

@GenModel(documentation="Abstract base for ledger entries. Entries are of two general types: assertions (statements of fact about an account at a date) and transactions (movements). A transaction can also be an assertion.")
abstract class Entry extends NamedElement {
    Date date
    EntryState state
    @GenModel(documentation="Provenance: which import/statement/observation produced this entry.")
    refers Source source
    refers Commodity commodity
}

@GenModel(documentation="A statement of fact about the containing account at a date, e.g. a balance per statement. Verification folds transactions between consecutive assertions and reports which interval on which account fails to reconcile.")
class Assertion extends Entry {
    BigDecimal balance
}

@GenModel(documentation="A movement on the containing account, with or without a corresponding transaction on another account. Single-leg transactions are permitted to support the staged workflow; the correspondent leg may be assigned later.")
class Transaction extends Entry {
    BigDecimal amount
    @GenModel(documentation="The corresponding transaction on another account, if known. Symmetric.")
    refers Transaction correspondent //opposite correspondent
}

/**
 * A transaction that is also an assertion: both the movement and the resulting balance are known facts, 
 * e.g. a confirmed transfer with a stated closing balance.")

 */
class TransactionAssertion extends Transaction, Assertion {
    
}

